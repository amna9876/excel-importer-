# Server
PORT=4000
NODE_ENV=development

# MongoDB — Atlas connection string (mongodb+srv://user:pass@cluster.../dbname)
MONGO_URI=mongodb://localhost:27017/excel-product-importer

# Redis (BullMQ)
# Set REDIS_URL to a full connection string (e.g. Upstash's "rediss://..." URL)
# and leave REDIS_HOST/PORT/PASSWORD blank — REDIS_URL takes priority when set.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=product-imports
# Only needed for LocalStack / S3-compatible endpoints. Leave blank for real AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Nodemailer (SMTP) — e.g. an Ethereal test account (https://ethereal.email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Product Imports <no-reply@example.com>"
