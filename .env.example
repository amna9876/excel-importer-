# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Neon connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (BullMQ) — Upstash "rediss://..." URL
REDIS_URL=

# RabbitMQ (event bus) — CloudAMQP "amqps://..." URL
RABBITMQ_URL=
RABBITMQ_QUEUE=product_events_queue

# S3-compatible storage (Backblaze B2)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_FORCE_PATH_STYLE=true

# Nodemailer (SMTP) — works for local dev. Some hosts (e.g. Railway's free
# plan) block outbound SMTP; use the EMAIL_RELAY_* pair below instead there.
# For local testing, an Ethereal test account works: https://ethereal.email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Product Imports <no-reply@example.com>"

# Optional HTTPS email relay — used instead of SMTP when set. Needed on hosts
# that block outbound SMTP. Points at a small Google Apps Script web app
# (see README) that sends the mail from a real Gmail account instead.
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
